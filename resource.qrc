<RCC>
    <qresource prefix="/shaderSource">
        <file alias="shader.frag">resource/shaderSource/shader.frag</file>
        <file alias="shader.vert">resource/shaderSource/shader.vert</file>
    </qresource>
    <qresource prefix="/icon">
        <file alias="open.svg">resource/icon/open.svg</file>
        <file alias="pause.svg">resource/icon/pause.svg</file>
        <file alias="play.svg">resource/icon/play.svg</file>
        <file alias="skip_next.svg">resource/icon/skip_next.svg</file>
        <file alias="skip_previous.svg">resource/icon/skip_previous.svg</file>
        <file alias="stop.svg">resource/icon/stop.svg</file>
        <file alias="close.svg">resource/icon/close.svg</file>
        <file alias="fullscreen.svg">resource/icon/fullscreen.svg</file>
        <file alias="fullscreen_exit.svg">resource/icon/fullscreen_exit.svg</file>
        <file alias="minimize.svg">resource/icon/minimize.svg</file>
        <file alias="maximize.svg">resource/icon/maximize.svg</file>
        <file alias="restore.svg">resource/icon/restore.svg</file>
        <file alias="volume_off.svg">resource/icon/volume_off.svg</file>
        <file alias="volume_on.svg">resource/icon/volume_on.svg</file>
        <file alias="repeat.svg">resource/icon/repeat.svg</file>
        <file alias="repeat_one.svg">resource/icon/repeat_one.svg</file>
        <file alias="shuffle.svg">resource/icon/shuffle.svg</file>
        <file alias="list.svg">resource/icon/list.svg</file>
        <file alias="AZPlayer.ico">resource/icon/AZPlayer.ico</file>
        <file alias="player_settings_closed.svg">resource/icon/player_settings_closed.svg</file>
        <file alias="player_settings_opened.svg">resource/icon/player_settings_opened.svg</file>
        <file alias="check_box_checked.svg">resource/icon/check_box_checked.svg</file>
        <file alias="list_opened.svg">resource/icon/list_opened.svg</file>
    </qresource>
</RCC>
